# Copy to .env.local and paste your Google Maps Platform API key.
# The key needs the Maps JavaScript API and the Elevation API enabled.
VITE_GOOGLE_MAPS_API_KEY=
# Optional map ID for the 2D minimap's advanced markers (create one in Cloud Console → Map Management).
# Leave empty to use Google's DEMO_MAP_ID, which is fine for development.
VITE_GOOGLE_MAPS_MAP_ID=
